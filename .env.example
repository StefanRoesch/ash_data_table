# Copy to `.env` only if you need to override the compose defaults.
# The demo app (demo/config/*.exs) reads the same variables from the
# environment, so export them when you change them.

POSTGRES_USER=ash_table
POSTGRES_PASSWORD=ash_table
POSTGRES_DB=demo_dev
# Host port Postgres is published on (loopback only).
POSTGRES_PORT=5477

# Optional `app` service (docker compose --profile demo up)
# Host port the demo is published on (loopback only).
DEMO_PORT=4478
# Database the containerised demo uses, separate from the host's demo_dev.
DEMO_APP_DB=demo_docker
# Seed profile for the containerised demo: standard | large
SEED=standard
# Image the demo runs (`up` pulls it, `up --build` builds it from here).
# DEMO_IMAGE=ghcr.io/stefanroesch/ash_data_table-demo:latest

# For the demo app run on the host (defaults shown):
# POSTGRES_HOST=localhost
# PORT=4478
